# Platform configuration. End users do not configure a domain or Cloudflare.
# These example domains are placeholders, not deployed services.
FLOWNIUM_ORIGIN=http://127.0.0.1:8787
# In deployment, use the platform's HTTPS address (a provider default URL is fine).
# Optional only: set a platform-owned namespace for personal subdomains.
FLOWNIUM_WORKSPACE_DOMAIN=
FLOWNIUM_IROH_BIN=dumbpipe

# GitHub OAuth app callback: FLOWNIUM_ORIGIN/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Scope to the platform account and the platform DNS zone.
# Optional transport: Cloudflare Tunnel Edit and DNS Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Run one account-service process behind an HTTPS reverse proxy.
BIND_HOST=127.0.0.1
PORT=8787
FLOWNIUM_SERVICE_DATA=./work/flownium-service
