# Copy to work/local-app.env (ignored by Git); keep secrets private.
FLOWNIUM_APP_PORT=8788
# Register this exact callback on your GitHub OAuth app:
# http://127.0.0.1:8788/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Register this exact callback on your Google OAuth web client:
# http://127.0.0.1:8788/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: browser entry point when running behind a TLS reverse proxy.
# Use that origin for the provider callbacks above, too.
# NECTIT_PUBLIC_ORIGIN=https://your-existing-gateway-host
# Optional nonstandard installed Hermes Desktop build:
# HERMES_DESKTOP_DIST=/absolute/path/to/desktop/dist
# Optional checksum-verified transport path:
# FLOWNIUM_IROH_BIN=/absolute/path/to/dumbpipe
